# ═══════════════════════════════════════════════════════════════════════════
# Aero Agent — Variables de entorno
# Uso: cp .env.example .env  →  completa los secretos antes de ejecutar
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=Aero Agent
APP_URL=http://localhost:3000

# ── Database (PostgreSQL + pgvector) ────────────────────────────────────────
# Docker Compose sobreescribe esta URL usando el nombre de servicio "postgres".
# Para desarrollo local (fuera de Docker) mantén localhost.
# IMPORTANTE: el nombre de la BD es "aeroagent" (sin guion), igual que en el compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aeroagent

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth — JWT ───────────────────────────────────────────────────────────────
# Nombres de variable tal como los lee el código (token.service.ts / jwt.strategy.ts)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=900                    # access token en segundos (900 = 15 min)
JWT_REFRESH_SECRET=change-me-refresh-production
JWT_REFRESH_EXPIRES_IN=7d                     # refresh token — formato ms/zeit (ej: 7d, 24h)

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_ENCRYPTION_KEY=9cd7512e6e492fc1ee99afb2c61a382d4bca7f6bde3063c1cb5d538908b7ec9e
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5

# ── Rate limiting (Throttler) ────────────────────────────────────────────────
THROTTLE_TTL=60                               # ventana en segundos
THROTTLE_LIMIT=100                            # máx. requests por ventana por IP

# ── File upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20

# ── Storage — S3 / MinIO ────────────────────────────────────────────────────
# Dev local: usa MinIO levantado por Docker Compose.
# Producción: reemplaza con credenciales reales de AWS S3 (quita S3_ENDPOINT y S3_FORCE_PATH).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=aeroagent-docs
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH=true                            # obligatorio para MinIO (path-style)

# ── LLM Providers (completa los que uses) ────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── External APIs ─────────────────────────────────────────────────────────────
NASA_API_KEY=DEMO_KEY                         # tier gratuito, funciona sin registro
SERPAPI_KEY=
